@article{brissaudLelaborationPrincipeDinalienabilite2013/dec./10,
  title = {L’élaboration du principe d’inaliénabilité pour les collections muséales et les biens du domaine public mobilier sous la Révolution française},
  author = {Brissaud, Olivia},
  year = {2013/déc./10},
  journaltitle = {Livraisons de l'histoire de l'architecture},
  shortjournal = {Livraisons Hist. Archit.},
  number = {26},
  pages = {141--156},
  publisher = {Association Livraisons d'histoire de l'architecture - LHA},
  issn = {1627-4970},
  doi = {10.4000/lha.343},
  url = {https://journals.openedition.org/lha/343},
  urldate = {2026-07-07},
  abstract = {À la veille de la Révolution française, l’objet d’art qu’il soit propriété de la Couronne ou patrimoine privé tend déjà à devenir un bien dont la valeur intrinsèque et les enjeux mercantiles qu’il implique, pousse les États à légiférer à son égard. Pour préserver l’héritage artistique, mis en péril par l’aliénation du Domaine en 1790, les artistes et commissaires pensent une nouvelle forme de protection~; leur premier enjeu est alors de faire reconnaître la propriété collective de cet ensemble artistique et d’élaborer une législation publique qui permettrait la défense des biens de l’art offerts à la jouissance de tous. Une véritable administration de l’art se met donc en place pour gérer à la fois les œuvres d’art destinées aux institutions muséales que les biens envoyés dans les ministères et autres palais d’État. L’inaliénabilité est passée ainsi d’une réalité constitutionnelle à une condition législative, dépendant de nouveaux critères. Ces biens artistiques désacralisés et hors de leur contexte, qu’ils aient été la propriété de la Couronne, de l’Église ou d’une nation étrangère, gagnent en fait une nouvelle sacralité conçue toute entière dans la Nation française, son identité et son histoire, formant ainsi un espace public quasi inédit pour l’époque.},
  langid = {french},
  file = {/home/florian/Zotero/storage/S95LFU76/Brissaud - 2013 - L’élaboration du principe d’inaliénabilité pour les collections muséales et les biens du domaine pub.pdf}
}

@article{bsirArtificialIntelligenceEnhancement2025,
  title = {Artificial intelligence for the enhancement of television archives Case study: The heritage of Tunisian television},
  shorttitle = {Artificial intelligence for the enhancement of television archives Case study},
  author = {Bsir, Besma and Hamed, Kaouthar and Laibidi, Oumaima and Wahada, Abir BEN},
  date = {2025-07-11},
  journaltitle = {Journal of Information Sciences},
  shortjournal = {J. Inf. Sci.},
  volume = {24},
  number = {1},
  pages = {1--20},
  issn = {2820-6894},
  doi = {10.34874/IMIST.PRSM/jis-v24i1.54261},
  url = {https://revues.imist.ma/index.php/JIS/article/view/54261},
  urldate = {2026-05-15},
  abstract = {Dans cet article, nous examinons les perspectives offertes par l’intelligence artificielle (IA) pour moderniser la gestion des archives au sein de l’Etablissement de la Télévision Tunisienne (ETT), dans un contexte de mutation numérique des médias publics. Si l’ETT ne dispose pas encore de solutions d’IA pleinement opérationnelles, plusieurs projets de coopération, notamment avec l’INA (France) et l’Union européenne, ont contribué à poser les fondations d’un environnement numérique structuré. L’intégration récente du système MAM DALET marque une étape décisive dans la centralisation et la numérisation des contenus. Notre étude, fondée sur une approche qualitative reposant sur l’observation de terrain et l’analyse documentaire, souligne les enjeux liés à la structuration, à la valorisation et à l’exploitation des archives télévisuelles, en particulier celles des journaux télévisés, véritables témoins de la mémoire nationale. Les résultats révèlent la nécessité d’une stratégie adaptée aux besoins spécifiques de l’ETT, en cohérence avec le plan national pour le déploiement de l’IA. Cette stratégie devrait définir des priorités claires, un calendrier réaliste et anticiper les ressources humaines, financières et techniques requises. Nous recommandons aussi le développement de partenariats, la formation spécialisée, une veille technologique continue, ainsi qu’une participation active aux réseaux professionnels comme la FIAT. Le recours à des start-up spécialisées, en cas de ressources internes limitées, est également envisagé. L’IA apparaît ainsi comme un levier de modernisation à fort potentiel culturel, économique et stratégique pour l’ETT. Mots clés : Intelligence artificielle; Média; Télévision; Archives télévisées; Journal télévisé; Tunisie.},
  langid = {french},
  file = {/home/florian/Zotero/storage/R4E4I22F/Bsir et al. - 2025 - Artificial intelligence for the enhancement of television archives Case study The heritage of Tunis.pdf}
}

