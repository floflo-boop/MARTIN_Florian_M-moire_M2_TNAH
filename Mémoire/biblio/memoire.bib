@thesis{friesValorisationMediationPatrimoines2023,
  type = {other},
  title = {La valorisation et la médiation des patrimoines écrits et graphiques en cinémathèque : le corpus d'affiches de cinéma de la Cinémathèque royale de Belgique},
  shorttitle = {La valorisation et la médiation des patrimoines écrits et graphiques en cinémathèque},
  author = {Fries, Juliette},
