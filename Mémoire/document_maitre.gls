		\setentrycounter[]{page}\glsnumberformat{124}}}\glsgroupskip
\glsgroupheading{Z}\relax \glsresetentrylist %
\glossentry{zsht}{\glossaryentrynumbers{\relax 
		\setentrycounter[]{page}\glsnumberformat{82}}}%
\end{theglossary}\glossarypostamble
